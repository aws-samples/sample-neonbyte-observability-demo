# Union of all five agents' dependencies, for local work outside containers.
# Images install only deploy/requirements.<agent>.txt.

# Orchestrator
strands-agents
strands-agents-tools

# Product Advisor (LangGraph)
langgraph
langchain-aws
langchain-core

# Order Desk (CrewAI, talks to Bedrock via LiteLLM)
# >=1.15: ADOT's CrewAI instrumentation needs the event ids newer CrewAI emits; without the floor the
# combined local resolve drops to 1.6.x and crew.kickoff() fails with "... has no attribute 'event_id'".
crewai>=1.15

# Support (LlamaIndex on Bedrock Converse)
llama-index-core
llama-index-llms-bedrock-converse

# Concierge (OpenAI Agents SDK -> Bedrock via LiteLLM / SigV4)
openai-agents[litellm]

# Shared
httpx
python-dotenv
boto3
bedrock-agentcore

# Observability — ADOT auto-instruments CrewAI, LangChain/LangGraph,
# LlamaIndex, and OpenAI Agents; Strands emits OTel natively.
aws-opentelemetry-distro>=0.18.0

# CVE floors shared by all agents
-c deploy/security-floors.txt
